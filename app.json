{
  "expo": {
    "name": "Jehoshua Academy of Marikina",
    "slug": "jehoshua-portal-marikina",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/pwa-512x512.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./public/pwa-512x512.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D47A1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jehoshua.portal.marikina"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/pwa-512x512.png",
        "backgroundColor": "#0D47A1"
      },
      "package": "com.jehoshua.portal.marikina",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./public/pwa-192x192.png"
    }
  }
}
